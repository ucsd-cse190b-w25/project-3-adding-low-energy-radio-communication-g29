#include "rtc.h"

/* Extern declaration for the error handler defined elsewhere */
extern void Error_Handler(void);

/* Declare an RTC handle */
RTC_HandleTypeDef hrtc;

void RTC_Init(void)
{
  /* Enable access to the backup domain */
  __HAL_RCC_PWR_CLK_ENABLE();
  HAL_PWR_EnableBkUpAccess();

  /* Configure the LSE oscillator */
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_LSE;
  RCC_OscInitStruct.LSEState = RCC_LSE_ON;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_NONE;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /* Select LSE as RTC clock source and enable RTC clock */
  __HAL_RCC_RTC_CONFIG(RCC_RTCCLKSOURCE_LSE);
  __HAL_RCC_RTC_ENABLE();

  /* Initialize RTC */
  hrtc.Instance = RTC;
  hrtc.Init.HourFormat = RTC_HOURFORMAT_24;
  hrtc.Init.AsynchPrediv = 127;  // For LSE=32.768 kHz
  hrtc.Init.SynchPrediv = 255;
  hrtc.Init.OutPut = RTC_OUTPUT_DISABLE;
  hrtc.Init.OutPutRemap = RTC_OUTPUT_REMAP_NONE;
  hrtc.Init.OutPutPolarity = RTC_OUTPUT_POLARITY_HIGH;
  hrtc.Init.OutPutType = RTC_OUTPUT_TYPE_OPENDRAIN;
  if (HAL_RTC_Init(&hrtc) != HAL_OK)
  {
    Error_Handler();
  }

  /* Make sure any previous wakeup timer is disabled and clear its flag */
  HAL_RTCEx_DeactivateWakeUpTimer(&hrtc);
  __HAL_RTC_WAKEUPTIMER_CLEAR_FLAG(&hrtc, RTC_FLAG_WUTF);

  /* Configure and enable the RTC Wakeup IRQ */
  HAL_NVIC_SetPriority(RTC_WKUP_IRQn, 0, 0);
  HAL_NVIC_EnableIRQ(RTC_WKUP_IRQn);
}

HAL_StatusTypeDef RTC_StartWakeUp(uint32_t period_ms)
{
  /* With LSE = 32.768 kHz and using a divider of 16,
     the wakeup clock frequency is 32768/16 = 2048 Hz.
     Each tick is ~0.488 ms. Calculate the counter for the desired period.
  */
  uint32_t wakeup_counter = (period_ms * 2048) / 1000;
  return HAL_RTCEx_SetWakeUpTimer_IT(&hrtc, wakeup_counter, RTC_WAKEUPCLOCK_RTCCLK_DIV16);
}

void RTC_StopWakeUp(void)
{
  HAL_RTCEx_DeactivateWakeUpTimer(&hrtc);
}

/* RTC Wakeup Interrupt Handler.
   Ensure that your interrupt vector (in the startup file or stm32l4xx_it.c)
   calls this function.
*/
void RTC_WKUP_IRQHandler(void)
{
  HAL_RTCEx_WakeUpTimerIRQHandler(&hrtc);
}
