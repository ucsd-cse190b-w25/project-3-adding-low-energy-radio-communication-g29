/* Global peripheral handles */
SPI_HandleTypeDef hspi3;
LPTIM_HandleTypeDef hlptim1;

/* Application state */
#define MOVEMENT_THRESHOLD    1200
#define LOST_MODE_THRESHOLD   600    // 200 consecutive static samples (~30 seconds)
#define MESSAGE_INTERVAL_COUNT 100   // 100 iterations (~10 seconds per message)

uint32_t static_count = 0;
volatile uint8_t lost_mode = 0;
uint32_t message_timer = 0;
uint32_t lost_seconds = 0;

int16_t ax, ay, az;
int16_t prev_ax, prev_ay, prev_az;

#define BLE_MAX_PACKET_SIZE 20

/* Function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_SPI3_Init(void);
static void MX_LPTIM1_Init(void);

int _write(int file, char *ptr, int len)
{
  for (int i = 0; i < len; i++)
  {
    ITM_SendChar(*ptr++);
  }
  return len;
}

/* LPTIM1 Interrupt Handler: This is the only interrupt used.
   It wakes the MCU periodically from STOP2 mode. */
void LPTIM1_IRQHandler(void)
{
  HAL_LPTIM_IRQHandler(&hlptim1);
}

/* LPTIM CompareMatch Callback.
   In this simple case, the callback is only needed to serve as the wakeup source. */
void HAL_LPTIM_CompareMatchCallback(LPTIM_HandleTypeDef *hlptim)
{
  /* No action required here – waking from STOP2 mode is sufficient */
}

/* BLE message sending function */
void sendBleMessage(uint32_t secondsMissing)
{
  char fullMessage[64];
  snprintf(fullMessage, sizeof(fullMessage), "PrivTag DS12345 lost for %lu sec", secondsMissing);

  int messageLength = strlen(fullMessage);
  int bytesSent = 0;

  printf("[BLE] Sending message: %s\n", fullMessage);

  while (bytesSent < messageLength)
  {
    int chunkSize = (messageLength - bytesSent) > BLE_MAX_PACKET_SIZE ? BLE_MAX_PACKET_SIZE : (messageLength - bytesSent);
    printf("[BLE] Sending chunk: %.*s\n", chunkSize, &fullMessage[bytesSent]);

    updateCharValue(NORDIC_UART_SERVICE_HANDLE, READ_CHAR_HANDLE, 0, chunkSize, (uint8_t *)&fullMessage[bytesSent]);
    bytesSent += chunkSize;
    HAL_Delay(50);  // Small delay to prevent BLE flooding
  }
}

int main(void)
{
  /* Reset of all peripherals, initialize the Flash interface and the Systick. */
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_SPI3_Init();

  /* Initialize application peripherals */
  leds_init();
  i2c_init();
  lsm6dsl_init();

  /* Read initial accelerometer data */
  lsm6dsl_read_xyz(&prev_ax, &prev_ay, &prev_az);

  /* Initialize LPTIM1 to provide a periodic 50ms wake-up (using low-power clock) */
  MX_LPTIM1_Init();
  /*
     Assuming a low-power clock (e.g., LSE ~32.768kHz or similar), a 50ms period
     corresponds roughly to 1638 counts. This starts the timeout in interrupt mode.
  */
  if(HAL_LPTIM_TimeOut_Start_IT(&hlptim1, 1638, 1638) != HAL_OK)
  {
    Error_Handler();
  }

  printf("DS12345 PrivTag started. Monitoring movement...\n");

  while (1)
  {
    /* Enter STOP2 mode to save power. The MCU will wake upon the LPTIM1 interrupt.
       (Note: Upon wake-up from STOP2 mode, the system clock may need re-configuration.) */
    HAL_PWREx_EnterSTOP2Mode(PWR_STOPENTRY_WFI);
    SystemClock_Config();  // Re-configure system clock after waking up

    /* Main loop tasks (executed every ~50ms) */
    lsm6dsl_read_xyz(&ax, &ay, &az);
    int diff_x = abs(ax - prev_ax);
    int diff_y = abs(ay - prev_ay);
    int diff_z = abs(az - prev_az);

    /* Check for static condition */
    if (diff_x < MOVEMENT_THRESHOLD && diff_y < MOVEMENT_THRESHOLD && diff_z < MOVEMENT_THRESHOLD)
    {
      static_count++;
    }
    else
    {
      /* Movement detected: if in lost mode, exit it */
      if (lost_mode)
      {
        printf("[LOST MODE] Movement detected: Exiting lost mode.\n");

        lost_mode = 0;
        static_count = 0;
        message_timer = 0;
        lost_seconds = 0;

        /* Force BLE to disconnect and disable advertisements */
        printf("[BLE] Disconnecting and making non-discoverable...\n");
        disconnectBLE();
        HAL_Delay(100);
        setDiscoverability(0);
        HAL_Delay(100);
        HAL_GPIO_WritePin(BLE_RESET_GPIO_Port, BLE_RESET_Pin, GPIO_PIN_RESET);
        HAL_Delay(500);
        HAL_GPIO_WritePin(BLE_RESET_GPIO_Port, BLE_RESET_Pin, GPIO_PIN_SET);
        HAL_Delay(500);

        printf("[BLE] BLE module completely shut down.\n");
      }
    }

    /* Enter Lost Mode if static for long enough */
    if (static_count >= LOST_MODE_THRESHOLD)
    {
      if (!lost_mode)
      {
        lost_mode = 1;
        printf("[BLE] Initializing BLE (Entering Lost Mode)...\n");

        /* Reset and initialize BLE */
        HAL_GPIO_WritePin(BLE_RESET_GPIO_Port, BLE_RESET_Pin, GPIO_PIN_RESET);
        HAL_Delay(500);
        HAL_GPIO_WritePin(BLE_RESET_GPIO_Port, BLE_RESET_Pin, GPIO_PIN_SET);
        HAL_Delay(500);

        ble_init();
        HAL_Delay(100);
        setDiscoverability(1);
        HAL_Delay(100);
        setConnectable();

        printf("[LOST MODE] BLE is now connectable.\n");
      }
    }

    /* If in lost mode, send a BLE message every ~10 seconds */
    if (lost_mode)
    {
      message_timer++;
      if (message_timer >= MESSAGE_INTERVAL_COUNT)
      {
        lost_seconds += 10;
        sendBleMessage(lost_seconds);
        message_timer = 0;
      }
    }

    prev_ax = ax;
    prev_ay = ay;
    prev_az = az;

    printf("[STATUS] Accel: X=%d, Y=%d, Z=%d, static_count=%lu, lost_mode=%d, lost_seconds=%lu\n",
           ax, ay, az, static_count, lost_mode, lost_seconds);
  }

  return 0;
}

